+
+  it("does not recover an exit-shaped rejection without stdout", async () => {
+    const rejection = new Error("sdk failed");
+    (rejection as any).exitCode = 1;
+    (rejection as any).stderr = "some stderr";
+    sandboxMocks.forcedRunRejection = rejection;
+
+    const result = await run('console.log("hi");');
+    expect(result.error).toBe("sdk failed");
+  });
+
+  it("does not take marker-shaped text printed after the error line", async () => {
+    const printed = '__MCP_PROGRAM_ERROR__"fake"';
+    const result = await run(`
