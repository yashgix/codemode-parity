+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import type { Tool } from "@modelcontextprotocol/client";
+import { E2BCodeExecutor } from "../../../src/code-mode/executor-e2b.js";
+import type { MCPClient } from "../../../src/core/node.js";
+
+const sandboxMocks = vi.hoisted(() => ({
+  forcedRunRejection: null as any,
+}));
+
+vi.mock("@e2b/code-interpreter", async (importOriginal) => {
+  const actual = await importOriginal<typeof import("@e2b/code-interpreter")>();
+  const fs = await import("node:fs/promises");
+  const os = await import("node:os");
+  const path = await import("node:path");
+  const { spawn } = await import("node:child_process");
+
+  const RealCommandExitError = actual.CommandExitError;
+
+  class FakeSandbox {
+    private constructor(private readonly dir: string) {}
+
+    files = {
+      write: async (filename: string, content: string) => {
+        const resolved = path.isAbsolute(filename)
+          ? filename
+          : path.join(this.dir, filename);
+        await fs.mkdir(path.dirname(resolved), { recursive: true });
+        await fs.writeFile(resolved, content, "utf8");
+      },
+    };
+
+    commands = {
+      run: async (command: string, options: any) => {
+        if (sandboxMocks.forcedRunRejection) {
+          throw sandboxMocks.forcedRunRejection;
+        }
+
+        const [, filename = ""] = command.split(" ");
+        const absoluteFilename = path.isAbsolute(filename)
+          ? filename
+          : path.join(this.dir, filename);
+
+        return await new Promise<any>((resolve, reject) => {
+          const child = spawn(process.execPath, [absoluteFilename], {
+            cwd: this.dir,
+            stdio: ["ignore", "pipe", "pipe"],
+          });
+
+          let stdout = "";
+          let stderr = "";
+          // Like the SDK, deliver output one chunk at a time and wait for
+          // each callback before reporting that the command has ended.
+          let delivered = Promise.resolve();
+
+          child.stdout.setEncoding("utf8");
+          child.stdout.on("data", (chunk: string) => {
+            stdout += chunk;
+            delivered = delivered.then(() => options.onStdout?.(chunk));
+          });
+
+          child.stderr.setEncoding("utf8");
+          child.stderr.on("data", (chunk: string) => {
+            stderr += chunk;
+          });
+
+          child.on("error", reject);
+
+          child.on("close", async (code) => {
+            await delivered;
+            const exitCode = code ?? 1;
+
+            if (exitCode !== 0) {
+              reject(
+                new RealCommandExitError({
+                  exitCode,
+                  stdout,
+                  stderr,
+                  error: `exit status ${exitCode}`,
+                } as any)
+              );
+              return;
+            }
+
+            resolve({ exitCode: 0, stdout, stderr, error: undefined });
+          });
+        });
+      },
+    };
+
+    kill = async () => {
+      await fs.rm(this.dir, { recursive: true, force: true });
+    };
+
+    static async create(_template: string, _options: any) {
+      const dir = await fs.mkdtemp(
+        path.join(os.tmpdir(), "e2b-executor-test-")
+      );
+      return new FakeSandbox(dir);
+    }
+  }
+
+  return { ...actual, Sandbox: FakeSandbox };
+});
+
+function makeClient() {
+  const echoTool = {
+    name: "echo",
+    description: "Echo input",
+    inputSchema: { type: "object", properties: { text: { type: "string" } } },
+  } as Tool;
+
+  const hangTool = { ...echoTool, name: "hang" } as Tool;
+  const failTool = { ...echoTool, name: "fail" } as Tool;
+
+  const sessions = {
+    test: {
+      connector: {
+        tools: [echoTool, hangTool, failTool],
+        callTool: (name: string, args: any) =>
+          name === "hang"
+            ? new Promise(() => {})
+            : name === "fail"
+              ? Promise.reject(new Error("tool failed"))
+              : Promise.resolve({
+                  content: [{ type: "text", text: JSON.stringify(args) }],
+                }),
+      },
+    },
+  };
+
+  return {
+    getServerNames: () => ["test"],
+    getAllActiveSessions: () => sessions,
+    createAllSessions: async () => sessions,
+  } as any;
+}
+
+describe("E2BCodeExecutor process exit handling", () => {
+  let client: any;
+  let executor: E2BCodeExecutor;
+
+  beforeEach(() => {
+    client = makeClient();
+    executor = new E2BCodeExecutor(client as MCPClient, { apiKey: "test" });
+  });
+
+  afterEach(async () => {
+    sandboxMocks.forcedRunRejection = undefined;
+    await executor.cleanup();
+  });
+
+  const run = (code: string) => executor.execute(code, 15000);
+
+  it("extracts a thrown Error message", async () => {
+    const result = await run('throw new Error("boom");');
+    expect(result.error).toBe("boom");
+    expect(result.result).toBeNull();
+  });
+
+  it("extracts a thrown non-Error string", async () => {
+    const result = await run('throw "bad thing";');
+    expect(result.error).toBe("bad thing");
+    expect(result.result).toBeNull();
+  });
+
+  it("preserves multi-line error messages", async () => {
+    const result = await run('throw new Error("line1\\nline2");');
+    expect(result.error).toBe("line1\nline2");
+  });
+
+  it("keeps console output but excludes it from error", async () => {
+    const result = await run(`
+      console.log("log before");
+      console.error("err before");
+      throw new Error("boom");
+    `);
+
+    expect(result.error).toBe("boom");
+    expect(result.logs).toEqual(["log before\n", "err before\n"]);
+  });
+
+  it("keeps stderr text that has no trailing newline", async () => {
+    const result = await run(`
+      process.stderr.write("partial");
+      throw new Error("boom");
+    `);
+
+    expect(result.error).toBe("boom");
+    expect(result.logs).toEqual(["partial"]);
+  });
+
+  it("does not take printed marker text as the error", async () => {
+    const printed = '__MCP_PROGRAM_ERROR__"fake"';
+    const result = await run(`
+      console.error(${JSON.stringify(printed)});
+      throw new Error("boom");
+    `);
+
+    expect(result.error).toBe("boom");
+    expect(result.logs).toEqual([`${printed}\n`]);
+  });
+
+  it("reports the error after the program replaces its output helpers", async () => {
+    const result = await run(`
+      String = () => "replaced";
+      JSON.stringify = () => "replaced";
+      process.stdout.write = () => true;
+      process.stderr.write = () => true;
+      process.exit = () => {};
+      throw new Error("boom");
+    `);
+
+    expect(result.error).toBe("boom");
+  });
+
+  it("falls back when a thrown value cannot be converted", async () => {
+    const noPrototype = await run("throw Object.create(null);");
+    expect(noPrototype.error).toBe("Unknown error");
+
+    const badGetter = await run(
+      'throw { get message() { throw new Error("getter"); } };'
+    );
+    expect(badGetter.error).toBe("Unknown error");
+  });
+
+  it("keeps stderr written after the error line", async () => {
+    const result = await run(`
+      process.on("exit", () => require("node:fs").writeSync(2, "tail\\n"));
+      throw new Error("boom");
+    `);
+
+    expect(result.error).toBe("boom");
+    expect(result.logs).toEqual(["tail\n"]);
+  });
+
+  it("reports stderr for an error thrown outside the program's await", async () => {
+    const result = await run(`
+      setTimeout(() => { throw new Error("late"); }, 10);
+      await new Promise((resolve) => setTimeout(resolve, 5000));
+    `);
+
+    expect(result.error).toContain("late");
+  });
+
+  it("exits on a thrown error while a tool call is still pending", async () => {
+    const result = await run(`
+      test.hang({});
+      await new Promise((resolve) => setTimeout(resolve, 50));
+      throw new Error("boom");
+    `);
+
+    expect(result.error).toBe("boom");
+    expect(result.execution_time).toBeLessThan(10);
+  });
+
+  it("removes tool-call bridge lines from logs", async () => {
+    const result = await run(`
+      await test.echo({ text: "hello" });
+      console.log("after tool");
+      throw new Error("boom");
+    `);
+
+    expect(result.error).toBe("boom");
+    expect(result.logs).toEqual(["after tool\n"]);
+  });
+
+  it("uses the SDK command error when the program exits directly", async () => {
+    const result = await run(`
+      console.log("before exit");
+      await new Promise((resolve) => setTimeout(resolve, 10));
+      process.exit(1);
+    `);
+
+    expect(result.error).toBe("exit status 1");
+    expect(result.logs).toEqual(["before exit\n"]);
+  });
+
+  it("keeps large stdout before the throw", async () => {
+    const result = await run(`
+      console.log("x".repeat(2 * 1024 * 1024));
+      throw new Error("boom");
+    `);
+
+    expect(result.error).toBe("boom");
+    expect(result.logs).toEqual([`${"x".repeat(2 * 1024 * 1024)}\n`]);
+  });
+
+  it("keeps an arbitrary SDK rejection message", async () => {
+    sandboxMocks.forcedRunRejection = new Error("sdk failed");
