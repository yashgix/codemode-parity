+
+// The SDK rejects on a non-zero exit, with the command's output on the error.
+function isCommandExit(error: any): boolean {
+  return (
+    typeof error?.exitCode === "number" &&
+    error.exitCode !== 0 &&
+    typeof error.stdout === "string" &&
+    typeof error.stderr === "string"
+  );
+}
