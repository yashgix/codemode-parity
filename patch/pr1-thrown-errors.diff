+    .join("\n");
+}
+
+// The wrapper's marker line carries the message of a thrown error. The marker
+// is new for every run, so printed text cannot imitate it by accident.
+function splitProgramError(
+  stderr: string,
+  marker: string
+): {
+  message?: string;
+  output: string;
+} {
+  const start = stderr.lastIndexOf(`\n${marker}`);
+  if (start === -1) return { output: stderr };
+
+  const from = start + marker.length + 1;
+  const newline = stderr.indexOf("\n", from);
+  const end = newline === -1 ? stderr.length : newline;
+  try {
+    const message = JSON.parse(stderr.slice(from, end));
+    if (typeof message === "string") {
+      return {
+        message,
+        output: stderr.slice(0, start) + stderr.slice(end + 1),
+      };
+    }
+  } catch {
+    // Printed text that only looks like the marker.
+  }
+  return { output: stderr };
+}
+
+function normalizeTimeoutError(message: string): string {
+  return message.includes("timeout") || message.includes("timed out")
+    ? "Script execution timed out"
+    : message;
+}
